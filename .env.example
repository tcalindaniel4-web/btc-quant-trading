# Copiază acest fișier în .env și completează valorile.
# Token API BGeometrics (gratuit): https://bitcoin-data.com -> cont -> API key
BGEOMETRICS_TOKEN=pune_tokenul_aici
# Opțional: cont de TEST Alpaca (app.alpaca.markets -> Paper -> API Keys), pentru execuția botului SDCA
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_SINCRONIZARE=0
# Opțional: asistentul Vega (Google AI Studio -> Get API key); GEMINI_MODEL schimbă modelul principal
GEMINI_API_KEY=
